generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  password     String
  name         String
  createdAt    DateTime       @default(now())
  portfolio    PortfolioItem[]
  settings     UserSettings?
}

model PortfolioItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  shares    Float
  buyPrice  Float
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserSettings {
  id              String @id @default(uuid())
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskTolerance   String @default("moderate")
  investmentGoal  String @default("growth")
  experienceLevel String @default("beginner")
}
