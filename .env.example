# ---------------------------------------------------------------------------
# Public client variables (safe to expose — Vite inlines VITE_* into the bundle)
# ---------------------------------------------------------------------------
VITE_APP_ORIGIN=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE_URL=http://localhost:5000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only (Vercel Functions + Express). Never prefix these with VITE_.
# ---------------------------------------------------------------------------
APP_ORIGIN=http://localhost:5173
NODE_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — server-only. /api/gemini-coach uses gemini-3.6-flash. Never prefix with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Plaid — used by /api/plaid/create-link-token, /exchange-token, /accounts
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_INSTITUTION_ID=ins_109508
PLAID_REDIRECT_URI=

# Polygon.io — used by /api/stocks/* (quotes, ticker details, aggregate charts)
POLYGON_API_KEY=
